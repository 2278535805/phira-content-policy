{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "forbidden",
        "restricted",
        "free"
      ]
    },
    "reason": {
      "type": "string"
    },
    "note": {
      "type": "string"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "status"
  ],
  "additionalProperties": true,
  "title": "Artist",
  "description": "An artist entry TOML file under data/artists/."
}
