{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "forbidden",
        "restricted",
        "free"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "status"
  ],
  "additionalProperties": true,
  "title": "Rights Holder Policy",
  "description": "Top-level _policy.toml for a rights holder directory."
}
